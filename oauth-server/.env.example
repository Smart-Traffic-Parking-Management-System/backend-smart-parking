PORT=3002
NODE_ENV=development

# JWT Configuration
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_PANJANG_MINIMAL_32_CHAR
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=86400

# Admin User (default admin, wajib ada 1 user ini)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smartcity.local
ADMIN_PASSWORD=admin@123

# Google OAuth (optional)
# Jika tidak ada, Google login akan disabled
GOOGLE_CLIENT_ID=GANTI_DENGAN_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GANTI_DENGAN_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3002/oauth/google/callback


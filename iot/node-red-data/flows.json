        "type": "function",
        "z": "tab-traffic",
        "name": "Simpan Token",
        "func": "const token = msg.payload?.data?.access_token;\nif (token) {\n    flow.set('service_token', token);\n    node.log('Token saved');\n}\nreturn msg;",

# API Gateway configuration
PORT=3000
NODE_ENV=development

# OAuth2 server
OAUTH_SERVER_URL=http://oauth-server:3002
OAUTH_INTROSPECT_PATH=/oauth/introspect
OAUTH_INTROSPECTION_API_KEY=GANTI_DENGAN_API_KEY

# Downstream service URLs
CITIZEN_SERVICE_URL=http://citizen-service:8000
TRAFFIC_SERVICE_URL=http://traffic-service:8001
PARKING_SERVICE_URL=http://parking-service:8002
PYTHON_ML_URL=http://python-ml:5000

# Rate limiting
GLOBAL_RATE_LIMIT_WINDOW_MINUTES=15
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MINUTES=60
AUTH_RATE_LIMIT_MAX=500

# Logging
LOG_FORMAT=combined

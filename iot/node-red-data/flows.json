        "type": "function",
        "z": "97165d3ca7348b2c",
        "name": "Build Token Request",
        "func": "msg.method = 'POST';\nmsg.url = 'http://oauth-server:3002/oauth/token';\nmsg.headers = {\n    'Content-Type': 'application/x-www-form-urlencoded'\n};\nmsg.payload = 'grant_type=client_credentials&client_id=smartcity_client&client_secret=SmartCity%40OAuth%232024';\nreturn msg;",

PORT=3002
NODE_ENV=development
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_PANJANG
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=86400

# Sample OAuth clients
OAUTH_CLIENT_ID=smartcity_client
OAUTH_CLIENT_SECRET=GANTI_DENGAN_SECRET_CLIENT

# Sample user login credentials
USER_USERNAME=admin
USER_PASSWORD=admin123

# User warga contoh (role=citizen)
# Untuk production: autentikasi langsung dari tabel citizens di DB
CITIZEN_USERNAME=warga1
CITIZEN_PASSWORD=warga123

# Token introspection access
INTROSPECTION_API_KEY=GANTI_DENGAN_API_KEY

# Google OAuth (external identity provider)
GOOGLE_CLIENT_ID=GANTI_DENGAN_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GANTI_DENGAN_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3002/oauth/google/callback

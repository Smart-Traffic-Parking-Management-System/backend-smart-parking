    {
        "id": "ff1fc2012bd0f5dd",
        "type": "function",
        "z": "97165d3ca7348b2c",
        "name": "Parse Traffic",
        "func": "var payload = msg.payload;\nif (typeof payload === 'string') {\n    try {\n        payload = JSON.parse(payload);\n    } catch(e) {\n        node.warn('Gagal parse JSON: ' + e.message);\n        return null;\n    }\n}\nvar zoneMap = {zone1:1, zone2:2, zone3:3, zone4:4, zone5:5};\nvar parts = (msg.topic || '').split('/');\nvar zoneName = parts[1] || 'zone1';\nvar zoneId = zoneMap[zoneName] || 1;\nmsg.payload = {\n    zone_id: zoneId,\n    vehicle_density: parseFloat(payload.vehicle_density) || 0,\n    avg_speed_kmh: parseFloat(payload.avg_speed_kmh) || 0,\n    incident_flag: 0,\n    source: 'iot'\n};\nnode.status({fill:'blue', shape:'dot', text: zoneName + ' d=' + msg.payload.vehicle_density});\nreturn msg;",
        "outputs": 1,
        "x": 360,
        "y": 200,

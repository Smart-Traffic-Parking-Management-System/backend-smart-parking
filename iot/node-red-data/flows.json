    {
        "id": "dcf1d50cf8e3e80c",
        "type": "function",
        "z": "97165d3ca7348b2c",
        "name": "Simpan Token",
        "func": "var body = msg.payload;\nif (body && body.access_token) {\n    flow.set('accessToken', body.access_token);\n    node.status({fill:'green', shape:'dot', text:'Token OK - ' + new Date().toLocaleTimeString()});\n    node.log('Token berhasil disimpan');\n} else {\n    node.status({fill:'red', shape:'ring', text:'Token GAGAL: ' + JSON.stringify(body)});\n    node.warn('Gagal dapat token: ' + JSON.stringify(body));\n}\nreturn null;",
        "outputs": 1,
        "x": 880,
        "y": 60,
        "wires": [
            []
        ]
    },

        "name": "Add Auth Token",
        "func": "msg.headers = msg.headers || {};\nmsg.headers[\"Authorization\"] = \"Bearer \" + flow.get('service_token');\nmsg.headers[\"Content-Type\"] = \"application/json\";\nreturn msg;",
